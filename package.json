{
  "name": "vertex-gaming",
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "build": "python3 scripts/build.py && npm run build:3d",
    "build:3d": "esbuild viewer.js --bundle --format=iife --minify --outfile=assets/vendor/viewer.bundle.js --legal-comments=eof",
    "catalog:sync": "python3 scripts/sync_catalog.py",
    "test": "node tests/site.cjs",
    "start": "python3 -m http.server 8080"
  },
  "devDependencies": {"three":"0.183.2", "esbuild":"0.28.2", "playwright":"1.58.2"}
}
